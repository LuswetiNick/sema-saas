# Design inventory only. Empty values disable dependent integrations.
# Set each value in its approved environment, not indiscriminately in one frontend file.

# Browser-visible endpoints; exact integration names must match the chosen auth adapter.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Server/auth configuration only.
SITE_URL=
BETTER_AUTH_SECRET=

# Backend adapter credentials; these are Sema configuration names, not API payload fields.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_TOKEN=
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_CHALLENGE=
RESEND_API_KEY=
SEMA_MAIL_FROM=

# Backend authenticated-encryption key; generate and manage outside source control.
# 32 random bytes, base64-encoded; never use the literal version name as a key.
SEMA_SENSITIVE_INPUT_KEY_V1_BASE64=

# Deployment credentials belong only in CI/secret storage, not in this file or browser code.
# Enrollment, checkout stages and emergency holds live in audited platformControls records.
