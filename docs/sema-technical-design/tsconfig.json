{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["convex/**/*.ts", "contracts/**/*.ts", "checks/**/*.ts"],
  "exclude": ["node_modules", ".verification"]
}
